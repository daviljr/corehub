{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "app",
    "components",
    "lib",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
